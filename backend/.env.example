# MongoDB Connection String (Local MongoDB or MongoDB Atlas Cloud URL)
MONGO_URI=mongodb://localhost:27017/randomconnect

# Clerk Authentication API Keys (Get it from https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Rewarded ad integration
# Use development/test mode locally. Set ENVIRONMENT=production and configure
# a real provider before accepting real rewarded-ad callbacks.
ENVIRONMENT=development
REWARDED_AD_PROVIDER=
REWARDED_ADS_TEST_MODE=true
